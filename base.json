{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "7 days",
  "dependencyDashboardApproval": false,
  "prCreation": "immediate",
  "automerge": true,
  "prConcurrentLimit": 1,
  "pre-commit": {
    "enabled": true
  },
  "hostRules": [
    {
      "matchHost": "dlong-081924037451.d.codeartifact.us-east-2.amazonaws.com",
      "hostType": "npm",
      "token": "{{ env.CODEARTIFACT_AUTH_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "description": "Group minor and patch updates together",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor-updates"
    },
    {
      "description": "Skip minimum release age for private registry packages",
      "matchRegistryUrls": ["https://dlong-081924037451.d.codeartifact.us-east-2.amazonaws.com"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Group Expo updates separately and prioritize over other updates",
      "matchPackageNames": ["expo", "expo-*", "@expo/*"],
      "groupName": "expo-updates",
      "prPriority": 10
    }
  ]
}
