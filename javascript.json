{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>24dlong/renovate-config//base.json"],
  "packageRules": [
    {
      "description": "Group vitest dependencies together",
      "matchPackagePatterns": ["^vitest$", "^@vitest/"],
      "matchUpdateTypes": ["major"],
      "groupName": "vitest-dependencies"
    },
    {
      "description": "Group react dependencies together",
      "matchPackagePatterns": ["react"],
      "groupName": "react-dependencies"
    },
    {
      "description": "Group typescript dependencies together",
      "matchPackagePatterns": ["^typescript$", "^typescript-eslint$", "^@typescript-eslint/"],
      "groupName": "typescript-dependencies"
    },
    {
      "description": "TypeScript majors need manual approval until typescript-eslint's peer range allows them",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "ESLint majors need manual approval until eslint-plugin-react and eslint-plugin-import (via eslint-config-expo) support ESLint 10",
      "matchPackageNames": ["eslint", "@eslint/js"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Exclude Storybook dependencies from Renovate",
      "matchPackagePatterns": ["storybook", "chromatic"],
      "enabled": false
    },
    {
      "description": "Isolate package manager updates and merge minor/major into a single PR",
      "matchPackageNames": ["pnpm"],
      "groupName": "package manager",
      "separateMajorMinor": false
    }
  ]
}
